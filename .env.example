# ──────────────────────────────────────────
# Servidor
# ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────
# WhatsApp Business Cloud API (Meta)
# ──────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_ACCESS_TOKEN=tu_access_token
WHATSAPP_VERIFY_TOKEN=tu_verify_token

# ──────────────────────────────────────────
# Telegram (modo piloto)
# Crea un bot con @BotFather y pega aquí el token.
# Si está vacío, el adaptador no se inicia.
# ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ──────────────────────────────────────────
# Google Sheets API
# ──────────────────────────────────────────
GOOGLE_SHEETS_ID=tu_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu_service_account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ntu_clave_privada\n-----END PRIVATE KEY-----"

# ──────────────────────────────────────────
# Zoom API
# ──────────────────────────────────────────
ZOOM_ACCOUNT_ID=tu_zoom_account_id
ZOOM_CLIENT_ID=tu_zoom_client_id
ZOOM_CLIENT_SECRET=tu_zoom_client_secret

# ──────────────────────────────────────────
# Landing Pages (dos perfiles)
# ──────────────────────────────────────────
VSL_VIDEO_URL=https://www.youtube.com/embed/tu_video_id
LANDING_URL=http://localhost:3000
# URL de la landing para agentes inmobiliarios profesionales
LANDING_PROFESIONAL_URL=https://tu-dominio.com/profesional
# URL de la landing para emprendedores / colaboradores (sobresueldo)
LANDING_EMPRENDEDOR_URL=https://tu-dominio.com/emprendedor

# ──────────────────────────────────────────
# Calendly (dos integraciones)
# Cuenta: Arcaich-25@hotmail.com (acceso por Google). Configurar horarios L-V 10:00 y M/X/J 19:00.
# Aquí van solo los ENLACES de reserva, no las credenciales de login.
# ──────────────────────────────────────────
# Enlace genérico para reuniones/cierres grupales
CALENDLY_GRUPAL_URL=https://calendly.com/arcaich/grupal
# Enlace para reuniones individuales (post-cierre, lo envía el agente)
CALENDLY_INDIVIDUAL_URL=https://calendly.com/arcaich/individual
# (compatibilidad con nombres antiguos)
CALENDLY_URL=https://calendly.com/arcaich/individual
REUNION_GRUPAL_URL=https://calendly.com/arcaich/grupal

# ──────────────────────────────────────────
# Agente
# ──────────────────────────────────────────
EMPRESA_NOMBRE=Three Inmobiliaria
EXPERTO_NOMBRE=Nombre del Experto
REMINDER_INTERVAL_HOURS=24
MAX_REMINDERS=3
DELAYED_BUTTON_SECONDS=60
# ──────────────────────────────────────────
# Acceso al CRM (usuario y contraseña)
# El panel (/monitor.html, /qr, /test.html) y la API privada (/api/*) piden
# estas credenciales. NUNCA se escriben aquí con su valor real: se ponen en
# las Variables de Entorno de Seenode.
# Si ADMIN_USER se deja vacío, vale cualquier usuario y solo cuenta la clave.
# Si no hay ADMIN_PASS (ni ADMIN_TOKEN), el CRM queda PÚBLICO.
# ──────────────────────────────────────────
ADMIN_USER=tu_usuario
ADMIN_PASS=tu_contrasena_larga_y_aleatoria

# ──────────────────────────────────────────
# LANZAMIENTO OCTUBRE 2026 — plantillas por SEGMENTO
# Cada segmento de la lista recibe su propio primer mensaje (reuniones 24-09
# y 01-10 con Arkaitz). Pon aquí el NOMBRE de cada plantilla tal cual quedó
# aprobada en Meta (WhatsApp Manager → Plantillas). Los cuerpos exactos están
# en templates/messages.js (PLANTILLAS_META) y en docs/LANZAMIENTO-OCT26.md.
# Un segmento SIN plantilla se queda en cola (no se le manda otra cosa).
# ──────────────────────────────────────────
# viejos (dic-25 a jun-26): si se deja vacío usa WHATSAPP_TEMPLATE_NAME (la de "reabrimos plazas")
WHATSAPP_TEMPLATE_VIEJOS=
# verano (jul-ago 26): "Con el verano de por medio…"
WHATSAPP_TEMPLATE_VERANO=reactivacion_verano
# septiembre y después: "Hace unos días mostraste interés…"
WHATSAPP_TEMPLATE_SEPTIEMBRE=reactivacion_septiembre
# nuevos en directo (hoja de Google / formulario / escriben al WhatsApp): "acabas de mostrar interés…"
WHATSAPP_TEMPLATE_DIRECTO=bienvenida_directo
# 1 = si a un segmento le falta plantilla, usar la genérica igualmente (por defecto NO: espera)
WHATSAPP_PLANTILLA_GENERICA_SI_FALTA=0
# Cortes de fecha de los segmentos (YYYY-MM-DD)
SEGMENTO_CORTE_VERANO=2026-07-01
SEGMENTO_CORTE_SEPTIEMBRE=2026-09-01
# Ritmo: no pasar de 20-25/día (Meta puede tomar el número por bot). Se cambia también desde el CRM.
LEADS_POR_DIA=25

# ──────────────────────────────────────────
# Hoja de Google de la campaña de Karen (leads nuevos en directo)
# La hoja "NUEVA: Captación agentes inmobiliarios" debe estar COMPARTIDA con
# GOOGLE_SERVICE_ACCOUNT_EMAIL (como lector). Cada SHEETS_POLL_MINUTES se dan
# de alta las filas nuevas con fecha >= SHEETS_DESDE y se les escribe al momento.
# ──────────────────────────────────────────
GOOGLE_SHEETS_TAB=DIC25
SHEETS_POLL_MINUTES=10
SHEETS_POLL_ENABLED=1
# Fecha desde la que una fila de la hoja cuenta como lead nuevo (lo anterior ya vino del CSV).
# Si se deja vacía, se fija el día del primer arranque.
SHEETS_DESDE=2026-10-03
# Horario para escribir AL MOMENTO a los leads nuevos en directo (fuera, esperan a primera hora)
DIRECTO_HORA_INICIO=9
DIRECTO_HORA_FIN=22

# ──────────────────────────────────────────
# Alta automática de quien escribe al WhatsApp del agente sin ser lead
# (el número del agente va en el formulario de Karen). 0 para desactivar.
# ──────────────────────────────────────────
AUTOALTA_WHATSAPP=1
AUTOALTA_MAX_HORA=20

# ──────────────────────────────────────────
# Flujo tras cualificar (1/2):
#   landing      → landing con vídeos → botón 1-a-1 (flujo actual, lanzamiento de octubre)
#   presentacion → invitación a la PRESENTACIÓN EN DIRECTO (Calendly grupal → Zoom) y,
#                  tras asistir, el 1-a-1. Siguiente fase decidida el 01-10 (formato 30-30).
# ──────────────────────────────────────────
FLUJO_TRAS_CUALIFICAR=landing
# Plantilla aprobada para recordar la reserva de la presentación en directo (solo modo presentacion;
# sin ella el recordatorio va como texto y solo llega dentro de la ventana de 24h)
WHATSAPP_TEMPLATE_RECORDATORIO_GRUPAL=
